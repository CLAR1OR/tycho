"type": "vec3",
"value": Vector3(0, 0, 0)
}

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.12, 0.11, 0.16, 1)
